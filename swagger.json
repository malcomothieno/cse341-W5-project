  },
  "components": {
    "schemas": {
      "EventInput": {
        "type": "object",
        "required": [
          "title",
          "description",
          "location",
          "startDate",
          "endDate",
          "category",
          "capacity",
          "organizerId"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "example": "Spring Career Fair"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "example": "Meet employers hiring interns and graduates."
          },
          "location": {
            "type": "string",
            "maxLength": 200,
            "example": "Student Center, Main Hall"
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-12T09:00:00.000Z"
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-12T15:00:00.000Z"
          },
          "category": {
            "type": "string",
            "enum": [
              "academic",
              "social",
              "sports",
              "career",
              "workshop",
              "other"
            ],
            "example": "career"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "example": 300
          },
          "organizerId": {
            "type": "string",
            "description": "ObjectId of the organizing user",
            "example": "665f1c2e8a1b2c3d4e5f6a7b"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "cancelled",
              "completed"
            ],
            "default": "scheduled",
            "example": "scheduled"
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "665f1c2e8a1b2c3d4e5f6a7b"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "example": "Spring Career Fair"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "example": "Meet employers hiring interns and graduates."
          },
          "location": {
            "type": "string",
            "maxLength": 200,
            "example": "Student Center, Main Hall"
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-12T09:00:00.000Z"
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-12T15:00:00.000Z"
          },
          "category": {
            "type": "string",
            "enum": [
              "academic",
              "social",
              "sports",
              "career",
              "workshop",
              "other"
            ],
            "example": "career"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "example": 300
          },
          "organizerId": {
            "type": "string",
            "description": "ObjectId of the organizing user",
            "example": "665f1c2e8a1b2c3d4e5f6a7b"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "cancelled",
              "completed"
            ],
            "default": "scheduled",
            "example": "scheduled"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-08T10:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-08T10:00:00.000Z"
          }
        }
      },
      "AnnouncementInput": {
        "type": "object",
        "required": [
          "title",
          "body",
          "category",
          "authorId"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "example": "Library extended hours during finals"
          },
          "body": {
            "type": "string",
            "maxLength": 5000,
            "example": "The main library will stay open until 2 AM from Dec 1 to Dec 14."
          },
          "category": {
            "type": "string",
            "enum": [
              "general",
              "academic",
              "safety",
              "facilities",
              "social"
            ],
            "example": "academic"
          },
          "authorId": {
            "type": "string",
            "description": "ObjectId of the author",
            "example": "665f1c2e8a1b2c3d4e5f6a7b"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-20T08:00:00.000Z",
            "description": "Defaults to the current time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-12-15T00:00:00.000Z",
            "nullable": true,
            "description": "Optional expiry date"
          }
        }
      },
      "Announcement": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "665f1c2e8a1b2c3d4e5f6a7b"
          },
          "title": {
            "type": "string",
            "maxLength": 150,
            "example": "Library extended hours during finals"
          },
          "body": {
            "type": "string",
            "maxLength": 5000,
            "example": "The main library will stay open until 2 AM from Dec 1 to Dec 14."
          },
          "category": {
            "type": "string",
            "enum": [
              "general",
              "academic",
              "safety",
              "facilities",
              "social"
            ],
            "example": "academic"
          },
          "authorId": {
            "type": "string",
            "description": "ObjectId of the author",
            "example": "665f1c2e8a1b2c3d4e5f6a7b"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-20T08:00:00.000Z",
            "description": "Defaults to the current time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-12-15T00:00:00.000Z",
            "nullable": true,
            "description": "Optional expiry date"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-08T10:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-08T10:00:00.000Z"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Validation failed"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "title is required"
            ]
          }
        }
      }
    }
  }
}
