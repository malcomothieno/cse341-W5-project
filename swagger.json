                "category": "academic",
                "authorId": "665f1c2e8a1b2c3d4e5f6a7b",
                "publishedAt": "2026-11-20T08:00:00.000Z",
                "expiresAt": "2026-12-15T00:00:00.000Z"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Announcement created",
            "content": {
