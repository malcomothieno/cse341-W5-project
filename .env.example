# Copy this file to ".env" for local development and fill in real values.
# On Render, add these same names under Environment > Environment Variables.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name used by the API
DB_NAME=campusconnect

# Port for local development (Render sets PORT automatically)
PORT=3000
