# Copy this file to ".env" for local development and fill in real values.
# On Render, add these same names under Environment > Environment Variables.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=campusconnect

# Port for local development (Render sets PORT automatically)
PORT=3000

# Long random string used to sign session cookies, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps)
# Local app callback:  http://localhost:3000/auth/github/callback
# Render app callback: https://<your-app>.onrender.com/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Optional: only set if a separate browser frontend will call this API with cookies
# FRONTEND_ORIGIN=https://your-frontend.example.com
